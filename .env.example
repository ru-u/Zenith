# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server-only; never expose to the client

# Market data
MARKET_DATA_PROVIDER=tradingview   # tradingview | polygon
POLYGON_API_KEY=                   # only required when MARKET_DATA_PROVIDER=polygon

# AI
ANTHROPIC_API_KEY=

# Cron
CRON_SECRET=                       # long random string; matches Vercel cron auth header

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # generated when the Stripe webhook endpoint is registered
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (optional, later)
RESEND_API_KEY=
