# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server-only; never expose to the client

# AI
# Only used in model prose mode; the quant engine itself is free and needs none
# of this. Both flags below must be set for a single Anthropic call to happen.
ANTHROPIC_API_KEY=
AI_THESES_ENABLED=false            # kill switch for ALL Anthropic spend; anything but "true" = off
AI_PROSE_MODE=template             # template ($0, deterministic) | model (also needs AI_THESES_ENABLED=true)

# Cron
CRON_SECRET=                       # long random string; matches Vercel cron auth header

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # generated when the Stripe webhook endpoint is registered
STRIPE_PRICE_ID=                   # Zenith Pro $4.99/mo Price; mode-specific — TEST id locally, LIVE id on Railway

# App — public base URL. Both are read by lib/site.ts siteUrl() in that order;
# set at least one. In production BOTH should be https://zenithscreener.com.
# NEXT_PUBLIC_* is inlined at BUILD time — changing these needs a rebuild.
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # preferred; drives metadataBase, sitemap, emails
NEXT_PUBLIC_APP_URL=http://localhost:3000    # legacy alias, kept as the fallback

# Email — pre-close drop + scraper failure alerts (optional; console-only if unset)
RESEND_API_KEY=
ALERT_EMAIL_TO=                    # where critical alerts are sent
ALERT_EMAIL_FROM=                  # verified Resend sender, e.g. "Zenith <drops@zenithscreener.com>".
                                   # Defaults to onboarding@resend.dev, which ONLY delivers to the
                                   # Resend account owner — set this or real users get nothing.

# Google Identity Services — the "Continue with Google" button. Public by
# design (it ships to the browser), but NEXT_PUBLIC_* is inlined at BUILD time,
# so changing it on Railway needs a rebuild, not a restart. If unset, the auth
# pages fall back to the Supabase redirect flow, whose consent screen names the
# Supabase project host instead of zenithscreener.com.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
