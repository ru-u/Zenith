# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server-only; never expose to the client

# AI
ANTHROPIC_API_KEY=

# Cron
CRON_SECRET=                       # long random string; matches Vercel cron auth header

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # generated when the Stripe webhook endpoint is registered
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email — scraper failure alerts (optional; console-only if unset)
RESEND_API_KEY=
ALERT_EMAIL_TO=                    # where critical alerts are sent
ALERT_EMAIL_FROM=                  # verified Resend sender; defaults to onboarding@resend.dev
